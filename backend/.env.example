# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 .gitignore에 있어 커밋되지 않습니다)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# 프롬프트 원문 위치 (기본: 저장소의 ai/test_prompts.py)
# AI_PROMPTS_FILE=../ai/test_prompts.py

# 기본은 backend/teamplus.db (SQLite). PostgreSQL 예: postgresql+psycopg://user:pass@localhost:5432/teamplus
# DATABASE_URL=sqlite:///./teamplus.db

# mock: 프론트와 같은 시연용 예약 현황 / jiphyeonjeon: 실제 집현전 연동 (구현 예정)
RESERVATION_PROVIDER=mock

# 추천에서 이 인원까지 빠지면 '주황', 더 빠지면 제외
MAX_MISSING_MEMBERS=1
