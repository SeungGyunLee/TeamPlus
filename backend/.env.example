# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 .gitignore에 있어 커밋되지 않습니다)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# 프롬프트 원문 위치 (기본: 저장소의 ai/test_prompts.py)
# AI_PROMPTS_FILE=../ai/test_prompts.py

# 기본은 backend/teamplus.db (SQLite). PostgreSQL 예: postgresql://user:pass@localhost:5432/teamplus
# Google Cloud(Cloud Run + Cloud SQL)는 이 파일이 아니라 Secret Manager에 넣어요 → deploy/GCP.md
# DATABASE_URL=sqlite:///./teamplus.db

# mock: 프론트와 같은 시연용 예약 현황 / jiphyeonjeon: 실제 집현전 현황 조회
RESERVATION_PROVIDER=mock

# 집현전 현황 조회 주소 — 학교 비공개 API, 사용 전 확인 필요.
# 주소는 팀 내부 문서('집현전 현황 조회 API 연동 안내')에만 있어요. 여기(.env.example)에는 절대 쓰지 마세요.
# backend/.env에만 넣고, RESERVATION_PROVIDER=jiphyeonjeon으로 바꾸면 실제 현황을 씁니다.
# JIPHYEONJEON_STATUS_URL=
# JIPHYEONJEON_MAP_URL=
# 같은 조회를 다시 쓰는 시간(초). 학교 서버 부담 때문에 180~300 권장
# JIPHYEONJEON_CACHE_SECONDS=180

# 추천에서 이 인원까지 빠지면 '주황', 더 빠지면 제외
MAX_MISSING_MEMBERS=1

# 로그인 유지 기간 (일). 지나면 다시 로그인
TOKEN_TTL_DAYS=30
# 비밀번호 재설정 인증 코드 유효 시간 (분)
PASSWORD_RESET_MINUTES=10

# 메일 발송: console(보내지 않고 서버 로그에 출력) | smtp(실제 발송)
MAIL_BACKEND=console
# smtp일 때만. 계정·비밀번호는 .env에만 쓰고 여기(.env.example)에는 쓰지 마세요.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=

# 웹 브라우저에서 API를 부를 수 있는 주소 (JSON 목록). Android 앱은 상관없음
# CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
