{
  "expo": {
    "name": "KW Meet",
    "slug": "kw-meet",
    "version": "1.0.0",
    "scheme": "kwmeet",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "kr.kwmeet.campus",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#773344"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  }
}
