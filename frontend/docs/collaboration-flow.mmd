  classDef outside fill:#edf0f4,stroke:#788496,color:#343d4d,stroke-width:2px
  class A,H,G,M,T,V,Q,F,R,P,L,U,D,S,Web,C,W,Local,Demo done
  class Ai,X,N,Save partial
  class Invite missing
  class Login,Book outside

  class Sim,Timeline,Progress,Context,ProjectShare,MeetingShare,Share done
  class Send outside
